<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.2fishdouble</groupId>
        <artifactId>butterfly-auto-configurations-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>butterfly-spring-boot-file-autoconfigure</artifactId>
    <name>butterfly-spring-boot-file-autoconfigure</name>
    <description>butterfly-spring-boot-file-autoconfigure</description>

    <dependencies>
        <dependency>
            <groupId>io.github.2fishdouble</groupId>
            <artifactId>butterfly-spring-boot-autoconfigure</artifactId>
        </dependency>

        <!--
            上传/下载接口需要 MultipartFile、ResponseEntity 等 Web 类型,声明为 optional:
            不引 Web 的应用仍可使用 FileStorage/FileService(纯 JDBC),只是不注册接口。
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 数据库驱动是使用方的实现选择,不能强制传递 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- 测试:接口用 MockMvc 验证映射,存储用 Testcontainers 启动真实 MySQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
