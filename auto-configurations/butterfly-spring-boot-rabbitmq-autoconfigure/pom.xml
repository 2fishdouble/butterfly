<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.2fishdouble</groupId>
        <artifactId>butterfly-auto-configurations-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>butterfly-spring-boot-rabbitmq-autoconfigure</artifactId>
    <name>butterfly-spring-boot-rabbitmq-autoconfigure</name>
    <description>butterfly-spring-boot-rabbitmq-autoconfigure</description>

    <dependencies>
        <dependency>
            <groupId>io.github.2fishdouble</groupId>
            <artifactId>butterfly-spring-boot-autoconfigure</artifactId>
        </dependency>

        <!--
            Spring Boot 4.2 起 spring-boot-starter-amqp 变成"通用 AMQP 1.0"(spring-amqp-client,
            包名 org.springframework.amqp.client),原来的 RabbitMQ 客户端(spring-rabbit,
            包名 org.springframework.amqp.rabbit)搬到 spring-boot-starter-rabbitmq。
            本模块用的是 RabbitMQ 专有的拓扑声明、模板与监听容器,因此必须用 rabbitmq 这一个 starter。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-rabbitmq</artifactId>
        </dependency>

        <!-- spring-amqp 的 JacksonJsonMessageConverter 把 Jackson 声明为可选依赖,这里显式引入以支持 JSON 序列化 -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
