<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.2fishdouble</groupId>
        <artifactId>butterfly-parent</artifactId>
        <version>${revision}</version>
        <relativePath>butterfly-parent/pom.xml</relativePath>
    </parent>

    <artifactId>butterfly</artifactId>
    <packaging>pom</packaging>


    <name>butterfly</name>
    <description>Butterfly Spring Boot starter (bom + autoconfigure + starter)</description>

    <modules>
        <module>butterfly-parent</module>
        <module>butterfly-bom</module>
        <module>butterfly-core</module>
        <module>auto-configurations/butterfly-spring-boot-autoconfigure</module>
        <module>auto-configurations/butterfly-spring-boot-redis-autoconfigure</module>
        <module>auto-configurations/butterfly-spring-boot-excel-autoconfigure</module>
        <module>auto-configurations/butterfly-spring-boot-security-autoconfigure</module>
        <module>auto-configurations/butterfly-spring-boot-mybatis-plus-autoconfigure</module>
        <module>auto-configurations/butterfly-spring-boot-mail-autoconfigure</module>
        <module>auto-configurations/butterfly-spring-boot-rabbitmq-autoconfigure</module>
        <module>auto-configurations/butterfly-spring-boot-netty-autoconfigure</module>
        <module>auto-configurations/butterfly-spring-boot-kafka-autoconfigure</module>
        <module>auto-configurations/butterfly-spring-boot-rocketmq-autoconfigure</module>
        <module>auto-configurations/butterfly-spring-boot-canal-autoconfigure</module>
        <module>starter/butterfly-spring-boot-starter</module>
        <module>sandbox/butterfly-sandbox-model</module>
        <module>sandbox/butterfly-sandbox</module>
        <module>sandbox/butterfly-sandbox-kafka</module>
        <module>sandbox/butterfly-sandbox-rabbitmq</module>
        <module>sandbox/butterfly-sandbox-rocketmq</module>
        <module>sandbox/butterfly-sandbox-canal</module>
        <module>butterfly-wechat</module>
    </modules>

    <!--
        All managed dependency versions live in butterfly-bom (single source of truth).
        Importing it here is what feeds the module poms; the BOM itself must not have this
        pom as its parent, otherwise Maven reports an import cycle.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.2fishdouble</groupId>
                <artifactId>butterfly-bom</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
