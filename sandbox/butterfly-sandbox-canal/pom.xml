<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.2fishdouble</groupId>
        <artifactId>butterfly-sandbox-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>butterfly-sandbox-canal</artifactId>
    <name>butterfly-sandbox-canal</name>
    <description>Butterfly Canal Sandbox</description>

    <dependencies>
        <dependency>
            <groupId>io.github.2fishdouble</groupId>
            <artifactId>butterfly-sandbox-model</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>io.github.2fishdouble</groupId>
            <artifactId>butterfly-spring-boot-canal-autoconfigure</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- repackage(可执行 jar)与"不发布"的配置在 butterfly-sandbox-parent 的 pluginManagement 里,这里只声明插件、
         给出本模块的启动类并保留本模块特有的 JVM 参数 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.github.butterfly.sandbox.ButterflySandboxCanalApplication</mainClass>
                    <!--
                        canal 1.1.8 的 CanalEntry 是 3.21.7 之前的 protoc 生成的("poison gencode"),新的
                        protobuf 运行时(这里是 4.35.1)一碰到这些类就逐个告警(GHSA-h4h5-3hr4-j3g2)。该属性
                        "存在即生效",这里在 spring-boot:run 的子进程上静音告警;将来 protobuf 把这类 gencode
                        改成直接抛异常时,它也是必需的兜底。
                    -->
                    <jvmArguments>-Dcom.google.protobuf.use_unsafe_pre22_gencode=true</jvmArguments>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
