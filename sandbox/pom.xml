<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.2fishdouble</groupId>
        <artifactId>butterfly</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>butterfly-sandbox-parent</artifactId>
    <packaging>pom</packaging>

    <name>butterfly-sandbox-parent</name>
    <description>Butterfly sandbox modules (aggregation and shared build configuration)</description>

    <modules>
        <module>butterfly-sandbox-model</module>
        <module>butterfly-sandbox</module>
        <module>butterfly-sandbox-kafka</module>
        <module>butterfly-sandbox-rabbitmq</module>
        <module>butterfly-sandbox-rocketmq</module>
        <module>butterfly-sandbox-canal</module>
        <module>butterfly-sandbox-curator</module>
    </modules>

    <dependencies>
        <!--
            沙箱各模块共用的编译期依赖:jspecify 提供包级 @NullMarked,lombok 由 @Data/@Slf4j 等使用。
            注意 jspecify 不能声明成 optional:Spring Framework 7 的运行期会直接读
            org.jspecify.annotations.Nullable(org.springframework.core.Nullness),
            而 optional 的直接声明会「遮蔽」spring-core 带进来的同名传递依赖,
            导致 repackage 出来的 fat jar 里没有 jspecify,启动时报
            NoClassDefFoundError: org/jspecify/annotations/Nullable。
        -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    可直接启动的沙箱应用共用的打包配置:
                    - repackage 打可执行 jar,启动类由各应用模块自己的 <configuration><mainClass> 给出;
                    - 沙箱应用不发布到仓库,因此跳过 deploy。
                    model 模块是库、不是可启动应用,不声明这两个插件,所以不会走 repackage/deploy 跳过。
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
